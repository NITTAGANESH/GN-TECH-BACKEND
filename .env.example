# Postgres connection string from Supabase: Project Settings -> Database -> Connection string (URI, "Session pooler" recommended)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Supabase project settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=gn-tech-uploads

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://gn-tech.vercel.app,http://localhost:5173
